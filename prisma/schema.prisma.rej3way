generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id           String            @id @default(cuid())
  name         String
  phone        String            @unique
  password     String            @default("")
  grade        String
  status       String            @default("pending")
  parentName   String            @default("")
  parentPhone  String            @default("")
  loginCount   Int               @default(0)
  lastLogin    DateTime?
  isPaidAccess Boolean           @default(false)
  // ربط الجهاز: الطالب بيسجل دخول من جهازه بس — المستر يقدر يسمح بكل الأجهزة
  // deviceId = هوية فريدة عشوائية (dev_) — عمود عادي بيتحدث (تشخيص/سجل)
  // deviceFp = بصمة "ناتج الجهاز" (dv3_) احتياطي لو بيانات المتصفح اتمسحت
  // creationDeviceId/creationDeviceFp = جهاز إنشاء الحساب — **ثابت لا يتغير أبدًا**
  //   بيتكتبوا مرة واحدة وقت التسجيل فقط، والدخول بيتحقق ضدهم حصريًا.
  //   ده اللي بيمنع أي إعادة ربط بالغلط على جهاز غريب.
  deviceId          String  @default("")
  deviceFp          String  @default("")
  deviceTraits      String  @default("")
  creationDeviceId  String  @default("")
  creationDeviceFp  String  @default("")
  deviceType        String  @default("")
  allowAllDevices Boolean @default(false)
  // (2026-و29) المجموعات — الطالب عضو في مجموعة واحدة (أو ولا حاجة لو فاضي)
  groupId      String  @default("")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  examResults  ExamResult[]
  activities   StudentActivity[]
  payments     Payment[]
}

// (2026-و37) حساب ولي أمر — مربوط بحساب ابنه بـ studentId.
// التسجيل بيتحقق من: اسم الطالب + تليفونه + باسورده + رقم ولي الأمر المسجل على حسابه.
// ولي الأمر بيدخل برقمه الشخصي وباسورده هو — ويشوف متابعة نتايج ابنه.
model Parent {
  id        String   @id @default(cuid())
  name      String   @default("")
  phone     String   @unique
  password  String   @default("")
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([studentId, action, createdAt])
  @@index([createdAt])
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String   @default("")
  filePath  String   @default("")
  fileType  String   @default("")
  thumbnail String   @default("")
  grade     String
  price     Float    @default(0)
  /* (2026-و106) الدرس فيه أكتر من فيديو — نفس نمط Zicola (و104):
     groupKey متطابق = أجزاء نفس الدرس، orderIndex = ترتيب الجزء داخل الدرس.
     فاضي "" = فيديو مستقل عادي (السلوك القديم زي ما هو). */
<<<<<<< platform
  groupKey  String   @default("")
  orderIndex Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
=======
  groupKey    String   @default("")
  orderIndex  Int      @default(0)
  /* (2026-د) مدة الفيديو بالثواني — بتمتلئ أول ما الفيديو يتفتح (تقرير
     المشغل) أو من سجلات المشاهدة — عشان بادج ⏱ على كروت الفيديوهات.
     0 = لسه معناش المدة. */
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
>>>>>>> mg-edited
}

model Homework {
  id            String   @id @default(cuid())
  title         String
  content       String   @default("")
  filePath      String   @default("")
  fileType      String   @default("")
  thumbnail     String   @default("")
  answerKeyPath String   @default("")
  answerKeyType String   @default("")
  grade         String
  questions     String           @default("")
  // (25-ب1) جدولة الظهور: قبل الموعد الطالب مش شايف الواجب خالص —
  // والأدمن شايفه ببادج «مجدول». null = يظهر فورًا.
  scheduledAt   DateTime?
  // (2026-و26) استهداف الطلاب — نفس نمط الفيديوهات (VideoSchedule):
  // JSON array بids طلاب محددين — فاضي "[]" = الكل يشوفه
  targetStudentIds String      @default("")
  // (2026-و29) استهداف المجموعات — زي الامتحانات بالظبط
  targetGroupIds  String      @default("")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  results       HomeworkResult[]
}

model HomeworkResult {
  id          String   @id @default(cuid())
  homeworkId  String
  studentId   String
  score       Float    @default(0)
  maxScore    Float    @default(100)
  answers     String   @default("")
  submittedAt DateTime @default(now())
  homework    Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@unique([studentId, homeworkId])
}

model Exam {
  id            String       @id @default(cuid())
  title         String
  content       String       @default("")
  filePath      String       @default("")
  fileType      String       @default("")
  thumbnail     String       @default("")
  answerKeyPath String       @default("")
  answerKeyType String       @default("")
  grade         String
  questions     String       @default("")
  // نماذج الامتحان العشوائية (طلب المستر): استخراج أكتر من ملف لنفس الامتحان
  // كل نموذج مفصول لوحده والطالب بيشوف نموذج واحد بس عشوائي ثابت لحسابه:
  // [{"name":"النموذج أ","filePath":"..","fileType":"..","questions":[..]}, ..]
  models        String       @default("")
  // طريقة توزيع النماذج (طلب المستر 2026-و: "ممكن أحط عشوائي ممكن أحط نموذج واحد بس")
  // random = عشوائي ثابت لكل طالب | fixed = نموذج واحد ثابت للكل (fixedModel = اسمه)
  modelMode     String       @default("random")
  fixedModel    String       @default("")
  passScore     Float        @default(50)
  // (25-ب1) طلبات المستر: (1) حرية إظهار/إخفاء الإجابات بعد التسليم —
  // false (افتراضي) = «انتظر النتيجة من المستر» بدون أي تفاصيل،
  // true = الطالب يشوف نتيجة الاختياري والأخطاء فور التسليم.
  showResult    Boolean      @default(false)
  // (2) مؤقت اختياري بالدقائق — 0 = بلا وقت (الواجهة/العدّاد عند الطالب)
  timeLimitMin  Int          @default(0)
  // (3) جدولة الظهور: قبل الموعد الطالب مش شايف الامتحان خالص —
  // والأدمن شايفه ببادج «مجدول». null = يظهر فورًا.
  scheduledAt   DateTime?
  // (2026-و26) استهداف الطلاب — نفس نمط الفيديوهات (VideoSchedule):
  // JSON array بids طلاب محددين — فاضي "[]" = الكل يشوفه
  targetStudentIds String      @default("")
  // (2026-و29) استهداف المجموعات — نفس نمط الاستهداف بالطلاب بالظبط:
  // JSON array بids المجموعات (StudentGroup) — الامتحان يظهر لأعضاء المجموعة
  // (مع scheduledAt: مخفي تمامًا قبل الموعد — من غير عداد)
  targetGroupIds  String      @default("")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  results       ExamResult[]
}

model ExamResult {
  id          String   @id @default(cuid())
  examId      String
  studentId   String
  score       Float    @default(0)
  maxScore    Float    @default(100)
  submittedAt DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([examId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discussion {
  id           String   @id @default(cuid())
  studentId    String
  studentName  String
  grade        String
  content      String
  isAdminReply Boolean  @default(false)
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  filePath  String
  fileType  String
  fileSize  String   @default("")
  data      String   @default("")
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoProgress {
  id             String   @id @default(cuid())
  studentId      String
  videoId        String
  watchedSeconds Float    @default(0)
  totalSeconds   Float    @default(0)
  completed      Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, videoId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String   @default("")
  filePath  String   @default("")
  type      String   @default("image")
  videoUrl  String   @default("")
  // (2026-و45) صورة مصغرة لعناصر الفيديو — افتراضيًا بيتجيب أوتوماتيك من
  // رابط اليوتيوب، والأدمن يقدر يعدّلها برابط صورة من عنده
  thumbnail String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id           String    @id @default(cuid())
  studentId    String
  studentName  String    @default("")
  studentPhone String    @default("")
  studentGrade String    @default("")
  method       String    @default("")
  amount       Float     @default(0)
  videoId      String    @default("")
  videoTitle   String    @default("")
  receiptPath  String    @default("")
  receiptType  String    @default("")
  status       String    @default("pending")
  note         String    @default("")
  reviewedAt   DateTime?
  reviewedBy   String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VideoAccess {
  id        String   @id @default(cuid())
  videoId   String
  studentId String
  grantedBy String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, studentId])
}

// ============================================================
// PlayTicket — تذكرة تشغيل فيديو تُستخدم مرة واحدة ولمدة قصيرة
// الهدف: معرف اليوتيوب أو مسار الملف لا يُرسل للطالب إطلاقاً —
// الطالب ياخد ticket عشوائي opaque، ومشغل الصفحة (api/player/[ticket])
// هو الوحيد اللي بيفتح الفيديو الحقيقي من على السيرفر.
// ============================================================
model PlayTicket {
  id        String   @id
  videoId   String
  studentId String   @default("")
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumed  Boolean  @default(false)

  @@index([expiresAt])
}

// ============================================================
// Complaint — صفحة الشكاوي: الطالب يكتب مشكلته (الاسم والتليفون
// بيتسجلوا تلقائي من حسابه) والشكوى تظهر للأدمن بس.
// source = "student" (الطالب كتبها بنفسه) أو "ai" (المساعد الذكي
// فهم إن الطالب بيشتكي من مشكلة وسجلها تلقائي).
// ============================================================
model Complaint {
  id          String    @id @default(cuid())
  studentId   String    @default("")
  studentName String    @default("")
  phone       String    @default("")
  grade       String    @default("")
  message     String
  summary     String    @default("")
  source      String    @default("student")
  status      String    @default("new")
  reply       String    @default("")
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@index([status])
  @@index([studentId])
}

// ============================================================
// (2026-و29) نظام المجموعات — طلب المستر الحرفي:
//   «عاوزين نقسم الطلاب لمجموعتين... مجموعة التلات أو مجموعة الأحد...
//    الفيديو يظهر لمجموعة والتانية ما يظهرلهاش غير في ميعادها»
// ============================================================
model StudentGroup {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  @@index([name])
}

// جدولة الفيديوهات للمجموعات — سطر لكل (فيديو × مجموعة):
//   unlockAt = null  → المجموعة تشوف الفيديو فورًا
//   unlockAt مستقبلي → الفيديو **مخفي تمامًا** عن المجموعة قبل الموعد
//                       (من غير عداد — طلب المستر صريح) وبيظهر عند موعدها
model VideoGroupSchedule {
  id        String    @id @default(cuid())
  videoId   String
  groupId   String
  unlockAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([videoId])
  @@index([groupId])
}

// ============================================================
// (2026-و44) الإشعارات — طلب المستر: «أي حاجة يتضاف تظهر له إشعار للطالب»:
//   • الأدمن رد على شكوى → الطالب ياخد إشعار «شكواك اتحلت/اترد عليها»
//   • كتاب/ملزمة جديدة → إشعار للطلاب (حسب الصف)
//   • امتحان/واجب/إعلان جديد → إشعار للطلاب المستهدفين
// read=true يعني الطالب شافه — العداد بيبقى unreadCount بس
// ============================================================
model Notification {
  id        String   @id @default(cuid())
  studentId String
  type      String   @default("general") // complaint_reply | book | exam | homework | announcement | general
  title     String
  body      String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, read])
  @@index([createdAt])
}

// ============================================================
// (2026-و40) الكتب والملازم — مكتبة PDF للطالب:
//   الأدمن يرفع كتاب/ملزمة PDF (chunkedUpload → Media → /api/files/<id>)
//   والطالب يفتحه أو يحمله من تاب «الكتب والملازم» في البورتال.
//   filePath بتخزن مسار /api/files/<mediaId> زي باقي الجداول.
//   (و43) sourceUrl = لينك خارجي للكتب الكبيرة — بدل تخزين الملف نفسه.
// ============================================================
model Book {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  filePath    String   @default("")
  sourceUrl   String   @default("")
  fileName    String   @default("")
  fileType    String   @default("application/pdf")
  sizeBytes   Int      @default(0)
  grade       String   @default("")
  /* (2026-و79) تصنيف الكتاب: واجب (homework) / أسئلة (questions) / الاتنين (both) */
  usage       String   @default("both")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// ============================================================
// (2026-و66) ساحة التحدي — طلب المستر: تحديات تفاعلية بين الطلاب
//   • BattleRoom: غرفة تحدي جروبات بكود مشترك (3-4 طلاب وقت واحد)
//     status: lobby (انتظار) | live (شغال) | ended (خلص)
//     questions: JSON — BattleQuestion[] من lib/question-gen
//     currentIndex/questionStartAt: السؤال الحالي وميعاد بدايته (epoch ms)
//   • BattlePlayer: لاعب في الغرفة — token سري للتحكم (الهوست بس يبدأ)
//     answers: JSON — { [رقم السؤال]: { choice, correct, gained, ms } }
// ============================================================
model BattleRoom {
  id              String   @id @default(cuid())
  code            String   @unique
  title           String   @default("")
  hostPlayerId    String   @default("")
  status          String   @default("lobby")
  questions       String   @default("[]")
  currentIndex    Int      @default(0)
  questionStartAt String   @default("0") // epoch ms كنص — INT مش لاقي 13 رقم
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
}

model BattlePlayer {
  id        String   @id @default(cuid())
  roomId    String
  name      String
  token     String   @default("")
  isHost    Boolean  @default(false)
  score     Int      @default(0)
  streak    Int      @default(0)
  answers   String   @default("{}")
  lastSeen  String   @default("0") // epoch ms كنص
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
}

// تحدي المستر — سؤال صعب أسبوعي/مخصص الطلاب يتسابقوا فيه
// والمستر نفسه ينزل يلعب معاهم (isTeacher في ChallengeEntry)
model TeacherChallenge {
  id           String    @id @default(cuid())
  title        String
  question     String
  options      String    @default("[]")
  correctIndex Int       @default(0)
  points       Int       @default(30)
  durationMin  Int       @default(0) // 0 = مفتوح لحد ما المستر يقفله
  active       Boolean   @default(true)
  closesAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ChallengeEntry {
  id          String   @id @default(cuid())
  challengeId String
  studentId   String   @default("")
  name        String
  isTeacher   Boolean  @default(false)
  choice      Int      @default(-1)
  correct     Boolean  @default(false)
  timeMs      Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([challengeId])
}

// نتايج تحدي الفلاش كاردز السريعة — لوحة شرف مستقلة
model FlashcardScore {
  id           String   @id @default(cuid())
  studentId    String   @default("")
  name         String
  score        Int      @default(0)
  correctCount Int      @default(0)
  totalCards   Int      @default(10)
  createdAt    DateTime @default(now())

  @@index([score])
}

// ============================================================
// (2026-و66) الخرائط الذهنية التفاعلية (NotebookLM style)
//   الأدمن يلصق لينك يوتيوب أو يرفع ملف → AI يستخرج المفاهيم
//   والقوانين → خريطة ذهنية JSON الطالب يشوفها تفاعلية
// ============================================================
model MindMap {
  id         String   @id @default(cuid())
  videoId    String   @default("")
  title      String
  sourceType String   @default("youtube") // youtube | text | file
  sourceUrl  String   @default("")
  sourceName String   @default("")
  data       String   @default("{}") // MindMapData JSON من lib/question-gen
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([videoId])
}

// ============================================================
// (2026-و87) إشعارات أولياء الأمور — طلب المستر: لما الطالب يسلّم
// امتحان أو واجب → إشعار لولي الأمر (اسم الطالب + العنوان + الدرجة)
// parent_id = رقم موبايل ولي الأمر مطبّع (010xxxxxxxx) أو id حسابه
// is_read: 0 غير مقروء | 1 مقروء — القوالب في src/lib/parent-notify.ts
// (في الإنتاج الجدول بيتعمل تلقائيًا من ensureParentNotificationsTable)
// ============================================================
model ParentNotification {
  id          Int      @id @default(autoincrement())
  parentId    String   @default("") @map("parent_id")
  studentName String   @default("") @map("student_name")
  message     String
  isRead      Int      @default(0) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([parentId, isRead])
  @@index([createdAt])
  @@map("parent_notifications")
}

// ============================================================
// (2026-و89) اشتراكات Web Push لولي الأمر — طلب المستر: «الإشعار
//   اللي هيجي لولي الأمر بره مش هيجي على الواتساب — إشعار براوزر
//   حقيقي يظهر على شاشة الموبايل».
//   كل صف = جهاز واحد اشترك لولي أمر:
//     parentId  = رقم موبايل ولي الأمر مطبّع (نفس parent_id في parent_notifications)
//     endpoint  = عنوان خدمة الـ push عند البراوزر (unique — إعادة الاشتراك بتتحدّث مش تتضاعف)
//     p256dh/auth = مفاتيح تشفير الحمولة (Web Push protocol)
//   الإرسال من lib/push.ts — الاشتراك من بوب-أب «تفعيل الإشعارات» في بورتال ولي الأمر
// ============================================================
model ParentPushSubscription {
  id        String   @id @default(cuid())
  parentId  String   @default("")
  endpoint  String   @unique
  p256dh    String   @default("")
  auth      String   @default("")
  userAgent String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}
